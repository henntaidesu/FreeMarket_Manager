# FreeMarket Manager —— 对外发布参考配置
#
# 链路：浏览器 → Cloudflare（TLS）→ 本 nginx（TLS）→ 后端 10.0.10.10（明文 HTTP，同局域网）
#
# 后端永不自带 TLS（见 backend/src/server.py 顶部注释），HTTPS 必须由本层终止。
# 回源那一跳是明文，因此 nginx 与后端**必须留在同一内网**；一旦回源跨公网，
# 登录密码与 JWT 就是明文传输，届时要改用 Cloudflare Tunnel 或把回源放进 VPN。

# ─────────────────────────────────────────────────────────────────────
# 1. 还原真实客户端 IP —— 不是可选项
# ─────────────────────────────────────────────────────────────────────
# 后端有两处按来源 IP 做判断，拿不到真实 IP 会直接出安全问题：
#   · 登录失败锁定的键是 username|ip（use_web/login/units/login_handler.py）。
#     所有人共用一个 IP 时，攻击者试 admin 会把真正的 admin 一起锁死，且可无限续。
#   · 公开图片端点的令牌桶按 IP 计（src/rate_limit.py）。共用一个桶时用户之间互相 429。
#
# 经过 Cloudflare 后 $remote_addr 是 CF 的边缘 IP，必须用 CF-Connecting-IP 还原。
# 下面的网段会变动，以官方列表为准：https://www.cloudflare.com/ips/
set_real_ip_from 173.245.48.0/20;
set_real_ip_from 103.21.244.0/22;
set_real_ip_from 103.22.200.0/22;
set_real_ip_from 103.31.4.0/22;
set_real_ip_from 141.101.64.0/18;
set_real_ip_from 108.162.192.0/18;
set_real_ip_from 190.93.240.0/20;
set_real_ip_from 188.114.96.0/20;
set_real_ip_from 197.234.240.0/22;
set_real_ip_from 198.41.128.0/17;
set_real_ip_from 162.158.0.0/15;
set_real_ip_from 104.16.0.0/13;
set_real_ip_from 104.24.0.0/14;
set_real_ip_from 172.64.0.0/13;
set_real_ip_from 131.0.72.0/22;
set_real_ip_from 2400:cb00::/32;
set_real_ip_from 2606:4700::/32;
set_real_ip_from 2803:f800::/32;
set_real_ip_from 2405:b500::/32;
set_real_ip_from 2405:8100::/32;
set_real_ip_from 2a06:98c0::/29;
set_real_ip_from 2c0f:f248::/32;
real_ip_header CF-Connecting-IP;

# dev server 的 HMR 需要 WebSocket 升级；只服务 dist 静态产物时用不到，留着无害。
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

upstream fmm_backend {
    server 10.0.10.10:9601;   # 开发态 9601；打包 exe 部署时改 9600
    keepalive 32;
}

# 前端形态二选一：
#   A. 静态产物（推荐对外用）—— root 指向 webside/dist，见下方 location /
#   B. vite dev server —— 把 location / 换成 proxy_pass http://10.0.10.10:9600;
#      仅限内网访问时使用：dev server 会暴露源码，allowedHosts:true 关掉了 DNS 重绑定防护，
#      且 /@fs/ 历史上出过任意读文件漏洞。不要把它开到公网。

server {
    listen 443 ssl;
    http2 on;
    server_name fmm.makurochan.com;

    ssl_certificate     /etc/nginx/ssl/fmm.makurochan.com.pem;
    ssl_certificate_key /etc/nginx/ssl/fmm.makurochan.com.key;
    ssl_protocols       TLSv1.2 TLSv1.3;

    # 上传上限：后端单文件限 25MB（use_web/image_storage.py:69），留出余量。
    # 少于这个值时大图上传会被 nginx 以 413 挡掉，且错误发生在后端之前、日志里不好找。
    client_max_body_size 32m;

    # ── 访问控制 ──────────────────────────────────────────────────
    # 应用自带用户体系与登录锁定，但 /imges 与两个公开图片端点在其之外。
    # 「我和少数几个固定的人」这个场景，优先用 Cloudflare Access（边缘拦截，
    # 扫描流量根本到不了这台机器，也不用维护 htpasswd）。
    # 没有 Access 时，用这一层 Basic 兜底 —— 它同时覆盖了 /imges：
    #   htpasswd -c /etc/nginx/fmm.htpasswd <user>
    #
    # ⚠ 启用「图床存储」后这层保护对已迁移的图片失效：/imges 会 302 到图床域名，
    # 浏览器直接去那边取图，根本不经过这台 nginx。图床的公开地址按设计就是无认证的
    # （文件名是随机 UUID，属于「知道地址才能访问」）。若这些图片不能对外可见，
    # 要么给图床域名也套上同样的 Access / Basic，要么在系统配置里把「图片投递方式」
    # 改成「代理」——那样图片仍由本服务转发，重新落回这层保护之内（但不省带宽）。
    auth_basic           "FreeMarket Manager";
    auth_basic_user_file /etc/nginx/fmm.htpasswd;

    # 安全响应头。CSP 未启用：Element Plus 与 Vue 运行时用了内联样式，
    # 直接上 default-src 'self' 会把界面打碎，需要单独调过再开。
    add_header X-Content-Type-Options nosniff       always;
    add_header X-Frame-Options        DENY          always;
    add_header Referrer-Policy        same-origin   always;
    add_header Strict-Transport-Security "max-age=31536000" always;

    # ── 前端（方案 A：静态产物）────────────────────────────────────
    root  /srv/freemarket/dist;   # 由 webside/ 下 npm run build 产出后同步过来
    index index.html;

    location / {
        try_files $uri $uri/ /index.html;   # SPA 前端路由兜底
    }

    # ── 后端 ─────────────────────────────────────────────────────
    # 前端 axios 的 baseURL 是 /mercariV2/src（webside/src/api/http.js:11），
    # 同源相对路径，所以这里只需按前缀转发，不用改前端。
    location /mercariV2/ { proxy_pass http://fmm_backend; include /etc/nginx/fmm_proxy.conf; }
    location /api/       { proxy_pass http://fmm_backend; include /etc/nginx/fmm_proxy.conf; }
    location /imges/     { proxy_pass http://fmm_backend; include /etc/nginx/fmm_proxy.conf; }

    # ── 不要把 mercari-proxy（9610）挂进本 server ────────────────
    # 它需要独立域名 + 独立认证，见文件末尾的 mp.* server 段。
}

# HTTP 一律跳转（Cloudflare 侧也应开 Always Use HTTPS）
server {
    listen 80;
    server_name fmm.makurochan.com;
    return 301 https://$host$request_uri;
}

# ─────────────────────────────────────────────────────────────────────
# Cookie 注入代理（mercari-proxy / 9610）—— 独立域名，认证不是可选项
# ─────────────────────────────────────────────────────────────────────
# 这是一个带着 Mercari/Yahoo 登录态的反向代理，务必单独一个 server / 单独一个域名。
#
# server.js 的 isAllowedClient 只看来源地址（环回 + 私有网段放行，server.js:101-105），
# 经 nginx 反代后来源恒为 nginx 的内网 IP —— 这道检查会被**完全绕过**，且
# MERCARI_PROXY_ALLOW_LAN=0 也救不了（那会把 nginx 自己一起挡掉）。
# 所以这个域名的访问控制**只能**由 nginx / Cloudflare Access 提供。缺了它，对外开放的
# 就是一个通往煤炉/雅虎的开放反向代理：会被人拿去中转，出口 IP 大概率被平台风控。
#
# 配好后在「系统配置 → Cookie 注入域名」填 https://mp.makurochan.com（该项存数据库，
# 不是环境变量；留空则回到「当前主机名 + 代理端口」的内网拼法）。
server {
    listen 443 ssl;
    http2 on;
    server_name mp.makurochan.com;

    ssl_certificate     /etc/nginx/ssl/mp.makurochan.com.pem;
    ssl_certificate_key /etc/nginx/ssl/mp.makurochan.com.key;
    ssl_protocols       TLSv1.2 TLSv1.3;

    # ↓ 见上，这一层不能省
    auth_basic           "Cookie Inject Proxy";
    auth_basic_user_file /etc/nginx/fmm.htpasswd;

    client_max_body_size 32m;

    location / {
        # 必须写 https：SCHEME 是 Node 侧的进程常量（server.js:327），由它自己有没有证书
        # 决定，而 cert.py 一直会生成自签证书 —— 所以 9610 恒为 TLS 端口，写 http:// 会直接
        # 握手失败。这也正是我们要的：只有 SCHEME=="https" 时 /__boot 才会给 Cookie 加上
        # Secure（server.js:294）、上游 Set-Cookie 里的 Secure 才不会被摘掉（server.js:419）。
        # 一旦退回 http，页面是 https 而 Cookie 没有 Secure，__Secure-/__Host- 前缀的那几条
        # 会被浏览器整条丢弃 —— 表现为「注入了 N 条但就是没登录」。
        # 证书是自签的（SAN 只含本机 IP），故关闭校验。
        proxy_pass            https://10.0.10.10:9610;
        proxy_ssl_verify      off;

        # Host 必须透传：server.js 用 req.headers.host（PROXY_HOST，server.js:125）改写页面、
        # Location 和注入脚本里的域名。传错了页面里的链接会全部指回内网地址。
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;

        # 上游站点用 WebSocket，代理侧走 /__pws__/（server.js:482）
        proxy_http_version 1.1;
        proxy_set_header Upgrade    $http_upgrade;
        proxy_set_header Connection $connection_upgrade;

        proxy_read_timeout 300s;
    }
}

server {
    listen 80;
    server_name mp.makurochan.com;
    return 301 https://$host$request_uri;
}

# ─────────────────────────────────────────────────────────────────────
# /etc/nginx/fmm_proxy.conf —— 上面三个 location 共用
# ─────────────────────────────────────────────────────────────────────
#   proxy_http_version 1.1;
#   proxy_set_header Host              $host;
#   proxy_set_header X-Real-IP         $remote_addr;
#   # 覆盖而非追加（不用 $proxy_add_x_forwarded_for）：只留一个可信 IP，
#   # 免得依赖 uvicorn 取列表首项还是末项的实现细节，也防客户端自己伪造前缀。
#   proxy_set_header X-Forwarded-For   $remote_addr;
#   proxy_set_header X-Forwarded-Proto $scheme;
#   proxy_set_header Upgrade           $http_upgrade;
#   proxy_set_header Connection        $connection_upgrade;
#   # 同步类接口可能跑很久；重活虽已进任务队列，但仍给足余量。
#   proxy_read_timeout 300s;
#   proxy_send_timeout 300s;
#
# ─────────────────────────────────────────────────────────────────────
# 后端侧必须同步设置的环境变量（backend 不读 .env，写进 start.bat 或服务定义）
# ─────────────────────────────────────────────────────────────────────
#   set MERCARI_FORWARDED_ALLOW_IPS=<nginx 所在机器的内网 IP>
#       ↑ 默认 127.0.0.1，nginx 不同机时必须改，否则上面的真实 IP 还原白做。
#   set CORS_ORIGINS=https://fmm.makurochan.com
#   set JWT_EXPIRE_HOURS=720
#   set MERCARI_HOST=10.0.10.10     （可选：不再绑 0.0.0.0，只监听内网口）
